pkgname=archivist
pkgver=0.1.3
pkgrel=1
pkgdesc='Lightweight Qt archive manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/seth-reee/archivist'
license=('MIT')
depends=('qt6-base' 'libarchive' 'gcc-libs' 'glibc')
optdepends=('qt6-wayland: native Wayland support' 'omarchy: automatic theme integration' 'rar: create and edit RAR archives')
makedepends=('cmake' 'ninja' 'gcc' 'pkgconf')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b424ebd773b134f9707f8098378c117cbb7231675d4617b4b7b7b390b7e471b9')

build() {
  cmake -S "$srcdir/Archivist-$pkgver" -B "$srcdir/build-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-$pkgver"
}

check() {
  ctest --test-dir "$srcdir/build-$pkgver" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-$pkgver"
}
